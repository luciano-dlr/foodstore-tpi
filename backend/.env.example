# Copiar este archivo como .env y completar los valores.
# El archivo .env no se entrega ni se sube al repositorio.

# Conexión a PostgreSQL (driver psycopg2). Para desarrollo rápido con SQLite:
#   DATABASE_URL=sqlite:///./foodstore.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/foodstore_tpi_db

# Firma del JWT: al menos 32 caracteres. Para generar una clave:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS (con credenciales)
FRONTEND_ORIGIN=http://localhost:5173
